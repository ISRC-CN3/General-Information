      <Device:Profiles>
        <rdf:Seq>
          <rdf:li rdf:parseType="Resource">
            <Device:Profile rdf:parseType="Resource">
              <Profile:Type>DepthPhoto</Profile:Type>
              <Profile:CameraIndices>
                <rdf:Seq>
